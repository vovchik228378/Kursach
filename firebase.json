{
    "hosting": {
        "target": "production",
        "public": "app/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "**/*.map"
        ],
        "rewrites": [{
            "source": "**",
            "destination": "/index.html"
        }],
        "headers": [{
                "source": "**",
                "headers": [{
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    },
                    {
                        "key": "Referrer-Policy",
                        "value": "strict-origin-when-cross-origin"
                    },
                    {
                        "key": "X-Frame-Options",
                        "value": "SAMEORIGIN"
                    },
                    {
                        "key": "Permissions-Policy",
                        "value": "geolocation=(self), camera=(), microphone=()"
                    },
                    {
                        "key": "Strict-Transport-Security",
                        "value": "max-age=31536000; includeSubDomains"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "/assets/**",
                "headers": [{
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }]
            },
            {
                "source": "**/*.@(png|jpg|jpeg|gif|ico|svg|webp|woff2)",
                "headers": [{
                    "key": "Cache-Control",
                    "value": "public, max-age=604800"
                }]
            }
        ]
    }
}
