# Скопируйте в .env.local и подставьте значения из Dashboard → Settings → API Keys
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Ключ Яндекс.Карт необязателен: без него приложение строит карту на OpenStreetMap.
# Если нужен именно Яндекс: https://developer.tech.yandex.ru/ → JavaScript API,
# в ограничениях указать localhost и домен Firebase.
# Старый ключ из курсового проекта недействителен ("Invalid API key").
VITE_YANDEX_MAPS_KEY=
